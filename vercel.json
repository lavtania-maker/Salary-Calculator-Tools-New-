{
  "rewrites": [
    { "source": "/admin",             "destination": "/admin.html"    },
    { "source": "/mincal",            "destination": "/mincal.html"   },
    { "source": "/payslip-generator", "destination": "/payslip.html"  },
    { "source": "/report",            "destination": "/report.html"   },
    { "source": "/socso-perkeso",     "destination": "/index.html"    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/qa-scheduler",
      "schedule": "0 18 * * 6"
    }
  ]
}
