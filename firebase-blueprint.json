{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A user who downloaded a resource",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address"
        },
        "name": {
          "type": "string",
          "description": "The user's name"
        },
        "action": {
          "type": "string",
          "description": "The action they took (e.g., Download Salary Report)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the lead was captured"
        },
        "userType": {
          "type": "string",
          "description": "The type of user (e.g., Employer / HR, Employee, Jobseeker)"
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's phone number"
        },
        "companyName": {
          "type": "string",
          "description": "The user's company name"
        },
        "hiringStatus": {
          "type": "string",
          "description": "The user's hiring status (if applicable)"
        }
      },
      "required": ["email", "action", "createdAt", "userType"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article published on the blog",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "metaTitle": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "array" },
        "metaDesc": { "type": "string" },
        "metaKeywords": { "type": "string" },
        "status": { "type": "string" },
        "publishedAt": { "type": "string" },
        "content": { "type": "string" },
        "readMoreUrl": { "type": "string" },
        "updatedAt": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["title", "slug", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": {
        "$ref": "#/entities/Lead"
      },
      "description": "Collection of captured leads"
    },
    "/blog_posts/{postId}": {
      "schema": {
        "$ref": "#/entities/BlogPost"
      },
      "description": "Collection of blog posts"
    }
  }
}
